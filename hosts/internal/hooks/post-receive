#!/usr/bin/env bash
set -eu

# Pin every patch set pushed for review, so it cannot become unreachable.
#
# jj rewrites a change in place: amending discards the previous commit, which then has no ref
# pointing at it and is gc-able. Review needs the opposite — comparing patch set 2 against
# patch set 1 is the core of reading a re-submitted change, and porting comments forward needs
# the version they were written against to still exist.
#
# Gerrit solves this with refs/changes/NN/CCCC/PP. The same trick works here and needs no
# database: `refs/changes/<change-id>/<n>`. Deliberately git-only — a hook that wrote to
# cresset-view's SQLite would need cross-user access to a WAL database, which is exactly what
# leaves /api/sync reporting no projects today.
# Wake the viewer as soon as the push lands, rather than leaving it to the two-minute timer.
#
# A sentinel file rather than `systemctl start`: this hook runs as `git`, and starting a unit
# owned by root would need a polkit rule or sudo — a privilege this account exists specifically
# not to have. A systemd .path unit watches this file and starts the refresh, so the escalation
# is systemd's rather than the hook's.
#
# Where the sentinels live. From the repository's own git config, defaulting to the production
# path, exactly as hooks/update reads its approvals file — a pusher cannot set repository
# config, and the environment is not worth trusting for a path this hook writes to.
#
# The default IS production, so the box behaves identically whether or not the key is set. What
# the knob buys is a sandbox that can watch these files: `flake.nix`'s canonical-review-hooks
# check points it at a temp directory and asserts which signals each kind of push raises. Before
# that, the only test of this mechanism was that the hook did not crash, and a sentinel that is
# never touched fails silently — cleanup would simply never hear about an abandoned change.
sentinels=$(git config --default /srv/git cresset.sentinelDir)

# Touched unconditionally, before any filtering: a push to `main` needs the viewer to notice
# just as much as a push to `review/*` does, and the loop below only concerns itself with the
# latter. `|| true` because a viewer that is a little stale is not a reason to reject a push.
touch "$sentinels/.refresh-requested" 2>/dev/null || true

# What this push asks for, decided inside the loop below.
#
# post-receive takes its refs on STDIN, NOT as arguments — `$1` is empty here, unlike in the
# update hook next door. Testing `$1` looked right and would have meant this never fired once.
submit_wanted=no
cleanup_wanted=no

while read -r _old new ref; do
  case "$ref" in
    # A change landed, so whatever it left in the downstream repositories — a review branch
    # and a draft pull request per project it touches — is now stale. Nothing else here cares
    # about `main`, so it is handled and skipped.
    refs/heads/main)
      cleanup_wanted=yes
      continue
      ;;
    refs/heads/review/*) ;;
    *) continue ;;
  esac

  # A deletion carries the zero oid as the new value, and there is nothing to record for one:
  # the patch sets already pinned under refs/changes/* are what keep the change readable, and
  # they outlive the bookmark on purpose. Without this, `git rev-list 0000...` fails with
  # `fatal: bad object` — and because the hook runs under `set -eu`, it aborts, so a push that
  # deleted one review bookmark and updated another would silently skip the update. Deleting a
  # landed bookmark is ordinary cleanup, which is how this was found.
  if [ "$new" = "0000000000000000000000000000000000000000" ]; then
    # A review bookmark going away IS the signal that cleanup wants, and for the case nothing
    # else can see: an abandoned change leaves nothing in the monorepo to notice, so this push
    # is the last moment anything here knows it existed.
    cleanup_wanted=yes
    continue
  fi

  # Past the deletion guard, so removing a bookmark does not trigger a submit round trip that
  # has nothing to do — it asks for a cleanup instead, above.
  submit_wanted=yes

  # Commits carried by this bookmark that have not landed. `--not refs/heads/main` is what
  # makes a stack of five commits record five changes rather than the whole history.
  if git rev-parse --verify --quiet refs/heads/main >/dev/null; then
    commits=$(git rev-list "$new" --not refs/heads/main)
  else
    commits=$(git rev-list "$new")
  fi

  for sha in $commits; do
    # The jj change id is an ordinary commit header, so plain git can read it and this hook
    # needs no jj on the server.
    cid=$(git cat-file commit "$sha" | sed -n 's/^change-id //p' | head -1)
    # A commit pushed by plain git has no change id. Not an error — it simply cannot be
    # tracked as a change, and saying so is better than inventing an identity for it.
    if [ -z "$cid" ]; then
      echo "note: $(git rev-parse --short "$sha") has no change-id; not tracked as a change" >&2
      continue
    fi

    # Idempotent: re-pushing an unchanged bookmark must not mint duplicate patch sets.
    if git for-each-ref --format='%(objectname)' "refs/changes/$cid/**" | grep -qx "$sha"; then
      continue
    fi

    n=$(( $(git for-each-ref --format='%(refname)' "refs/changes/$cid/**" | wc -l) + 1 ))
    git update-ref "refs/changes/$cid/$n" "$sha"
    echo "recorded patch set $n of change $cid ($(git rev-parse --short "$sha"))"
  done
done

# Ask for these changes to be submitted to the projects they affect, so their CI runs on them.
#
# A second sentinel rather than reusing the refresh one: refreshing the viewer is cheap and
# wanted after every push, while submitting talks to GitHub and is wanted only for review
# bookmarks. One file would make a push to main open pull requests it has no business opening.
#
# It carries no bookmark name, deliberately: `cresset-sync submit` with no revision covers every
# open review bookmark. That is idempotent — an unchanged branch force-pushes to the same commit
# and finds the same pull request — and self-healing, so anything an earlier failure left behind
# is picked up on the next push by anyone.
if [ "$submit_wanted" = yes ]; then
  touch "$sentinels/.submit-requested" 2>/dev/null || true
fi

# And ask for the downstream branches of changes that are no longer under review to be closed
# out. Its own sentinel for the same reason submit has one: this talks to GitHub and deletes
# things there, and it is wanted after a landing or an abandonment rather than after every push.
#
# It carries no name either. `cresset-sync cleanup` reads what exists downstream and compares it
# against what is under review, so it needs no hint about what changed — which is what makes it
# self-healing, and the only shape that can cope with an abandoned change whose only remaining
# trace is the branch name itself.
if [ "$cleanup_wanted" = yes ]; then
  touch "$sentinels/.cleanup-requested" 2>/dev/null || true
fi
